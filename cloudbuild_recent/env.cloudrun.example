# Guild-AI Cloud Run Environment Variables Template
# Copy this file and fill in the actual values for your deployment

# ============================================
# GOOGLE CLOUD PLATFORM CONFIGURATION
# ============================================
GOOGLE_CLOUD_PROJECT=guild-ai-080
FASTAPI_APP_ENV=production

# ============================================
# DATABASE CONFIGURATION (Cloud SQL)
# ============================================
CLOUDSQL_CONNECTION_NAME=guild-ai-080:us-central1:guild-ai-sql
POSTGRES_USER=postgres
POSTGRES_DB=workflow_db
DB_SECRET_NAME=db-root-password

# Note: POSTGRES_PASSWORD is retrieved from Secret Manager, not set here

# ============================================
# REDIS/MEMORYSTORE CONFIGURATION
# ============================================
REDIS_HOST=10.87.64.4
REDIS_PORT=6379

# Optional: Override Celery URLs if needed
# CELERY_BROKER_URL=redis://10.87.64.4:6379/0
# CELERY_RESULT_BACKEND=redis://10.87.64.4:6379/1

# ============================================
# LLM PROVIDER CONFIGURATION (Vertex AI)
# ============================================
LLM_PROVIDER=vertex_ai
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-pro

# Alternative models you can use:
# VERTEX_AI_MODEL=gemini-pro-vision
# VERTEX_AI_MODEL=text-bison
# VERTEX_AI_MODEL=chat-bison

# ============================================
# OPTIONAL: THIRD-PARTY INTEGRATIONS
# ============================================

# Together.ai (alternative LLM provider)
# TOGETHER_API_KEY=your-together-api-key

# HubSpot Integration
# HUBSPOT_API_KEY=your-hubspot-api-key

# n8n Webhook Integration
# N8N_WEBHOOK_URL=your-n8n-webhook-url

# ============================================
# AGENT CONFIGURATION
# ============================================
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT_MINUTES=30
AGENT_QUALITY_THRESHOLD=0.8
AGENT_CONFIDENCE_THRESHOLD=0.55

# ============================================
# SECURITY CONFIGURATION
# ============================================
FASTAPI_SECRET_KEY=generate-a-strong-random-secret-key-here

# CORS Configuration (comma-separated origins)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================
# DOCUMENT PROCESSING
# ============================================
MARKITDOWN_ENABLE_PLUGINS=true
MARKITDOWN_MAX_FILE_SIZE_MB=100
MARKITDOWN_AUDIO_TRANSCRIPTION=true
MARKITDOWN_YOUTUBE_TRANSCRIPTION=true

