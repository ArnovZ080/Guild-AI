{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "Bundler",
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "vite.config.*",
    "*.config.*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
